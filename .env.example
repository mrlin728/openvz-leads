# ============================================================
# OpenVZ Leads — environment variables
# Copy this file to .env and fill in what you need:  cp .env.example .env
# Never commit .env — it is gitignored.
#
# NOTHING HERE IS REQUIRED. With an empty .env, OpenVZ Leads still finds
# accounts, analyses them, drafts outreach and exports the results. Each
# key below buys you a specific upgrade.
# ============================================================

# ------------------------------------------------------------
# Serper.dev — Google Search API for prospecting  [OPTIONAL, most useful]
# Where: https://serper.dev → sign up → Dashboard → API Key
# Cost: ~$5 for 2,500 searches, no subscription.
# Without it, prospecting falls back to scraping DuckDuckGo/Bing, which
# gets rate-limited. This is the one key that most improves results.
SERPER_API_KEY=

# ------------------------------------------------------------
# Instantly — cold email sending  [OPTIONAL — only if you want it to send]
# Where: https://app.instantly.ai → Settings → Integrations → API Keys
# Note: API access requires Instantly's Growth plan or higher.
# Also set channels.email.provider to "instantly" in openvz-leads.yaml.
# Even then, human review stays on: nothing goes out unapproved.
INSTANTLY_API_KEY=

# ------------------------------------------------------------
# Google — sending from your own Gmail mailbox  [OPTIONAL]
# Also set channels.email.provider to "gmail" in openvz-leads.yaml, then
# authorise an account:  openvz-leads gmail login
#
# These two identify the *application*, not your account. Create them once:
#   https://console.cloud.google.com → new project
#   → APIs & Services → Library → enable "Gmail API"
#   → Credentials → Create credentials → OAuth client ID → "Desktop app"
#
# Your account is authorised separately, in a browser, by the command above.
# No password passes through this tool; only a refresh token is stored, in
# your workspace, readable by you alone.
#
# Before anything can send you also have to fill in
# channels.email.gmail.footer.postal_address — commercial email needs a real
# postal address, and Gmail will not add one for you.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------
# Hunter.io — email discovery/verification fallback  [OPTIONAL]
# Where: https://hunter.io → sign up → API → API Keys
# Free tier: 50 lookups/month. Used when pattern + SMTP verification
# can't confirm an address.
HUNTER_API_KEY=

# ------------------------------------------------------------
# Cloudflare Browser Rendering — JS-rendered crawling  [OPTIONAL]
# Enables deep crawling of your own site during `openvz-leads train`.
# Where:
#   Account ID: https://dash.cloudflare.com → sidebar of any zone, or the URL
#   API Token:  https://dash.cloudflare.com/profile/api-tokens → Create Token
#               → grant "Browser Rendering: Edit"
# Without these, the built-in HTTP crawler is used (no JS rendering).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ------------------------------------------------------------
# LinkedIn — browser-automation prospecting  [OPTIONAL, read the warning]
# WARNING: automating LinkedIn violates their Terms of Service and can get
# the account permanently restricted. It is off by default in
# openvz-leads.yaml and should stay off unless you accept that risk on an
# account you can afford to lose. Web search and company-site crawling find
# prospects without it.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ------------------------------------------------------------
# Model provider  [OPTIONAL — only if you are not using the Claude CLI]
# The default brain is the Claude Code CLI on this machine, which needs no
# key. Set model.provider in openvz-leads.yaml to switch, then one of:
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# MODEL_API_KEY=        # one override for whichever remote provider is set

# ------------------------------------------------------------
# CRM sync  [OPTIONAL]
# Bearer token for crm.webhook_url. Kept here rather than in the YAML
# because the YAML is the file people paste into bug reports.
CRM_WEBHOOK_TOKEN=

# ------------------------------------------------------------
# Where the database lives.  [OPTIONAL]
# Defaults to data/leads.db next to the install. Set this to run several
# workspaces (different products, different ICPs) from one install.
# OPENVZ_LEADS_DB=/path/to/workspace/leads.db


# ── Desktop app ───────────────────────────────────────────────────────
# Serve the dashboard without opening a window. The app normally runs in a
# window of its own; set this to 1 for a headless machine, a release smoke
# test, or when you would rather use your own browser.
# OPENVZ_LEADS_NO_WINDOW=1
